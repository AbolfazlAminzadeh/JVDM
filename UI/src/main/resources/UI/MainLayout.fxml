<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="609.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.Kroj.UI.Controllers.MainController">
    <left>
        <VBox prefWidth="200" spacing="10" style="-fx-background-color:#2c3e50; -fx-padding:10;" BorderPane.alignment="CENTER">
            <Label style="-fx-text-fill: #F0F8FF; -fx-font-size: 16;" text="Downloads" />

            <Button maxWidth="Infinity" onAction="#displayAll" text="All" />
            <Button maxWidth="Infinity" onAction="#displayDownloading" text="Downloading" />
            <Button maxWidth="Infinity" onAction="#displayComplete" text="Completed" />
            <Button maxWidth="Infinity" onAction="#displayPaused" text="Paused" />
            <Button fx:id="settings" maxWidth="Infinity" onAction="#displaySettings" prefHeight="0.0" prefWidth="180.0" text="Settings" textAlignment="CENTER" VBox.vgrow="NEVER" />
        </VBox>
    </left>

    <center>
        <SplitPane dividerPositions="0.6899618805590851">

            <VBox spacing="10" style="-fx-padding:10;">
                <Label text="Download List" />

                <TableView fx:id="tableView" prefHeight="400.0" prefWidth="513.0" VBox.vgrow="ALWAYS">

                    <columns>
                        <TableColumn fx:id="nameCol" prefWidth="200" text="Name" />
                        <TableColumn fx:id="progressCol" prefWidth="150" text="Progress" />
                        <TableColumn fx:id="speedCol" prefWidth="100" text="Speed" />
                    </columns>

                </TableView>
            </VBox>

            <VBox fx:id="detailsPanel" prefHeight="448.0" prefWidth="248.0" spacing="10" style="-fx-padding:15;">

                <Label fx:id="detailName" style="-fx-padding: 10; -fx-font-size: 14;" text="Select a download" />

                <Label fx:id="detailStatus" text="Status: -" />
                <Label fx:id="detailProgress" text="Progress: -" />
                <ProgressBar fx:id="detailBar" prefWidth="183.0" progress="0.0" />
                <Label fx:id="detailSpeed" text="Speed: -" />

                <HBox spacing="10">
                    <Button onAction="#onStart" style="-fx-background-color: #2cbd61; -fx-text-fill: white;" text="Start" />
                    <Button onAction="#onPause" style="-fx-background-color: #e6a83c; -fx-text-fill: white;" text="Pause" />
                    <Button onAction="#onDelete" style="-fx-background-color: #fb3333; -fx-text-fill: white;" text="Delete" />
                </HBox>

            </VBox>

        </SplitPane>
    </center>

</BorderPane>

{
  "manifest_version": 3,
  "name": "JVDM Browser Integration",
  "version": "1.0",
  "permissions": [
    "downloads",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.bundle.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}